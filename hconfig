#!/usr/bin/env python3
"""hconfig: one registry of every setting a node has, read through the core's own verbs.

    hconfig schema [PREFIX] [--json]          every known key with its schema (no values)
    hconfig list [PREFIX] [--class node|module|governed] [--json]
    hconfig get ID [--json]                   one record
    hconfig explain ID [--json]               the record and what its value means for this hive
    hconfig set ID [VALUE] [--stdin] [--device ID] [--non-interactive] [--json]
                                              node: keys, module keys, and (signed, through the unlock agent) a module's
                                              fleet and fleet-node keys; `core:` keys and node:owner_quota are owner-only
    hconfig unset ID [--json]                 node-scope module keys
    hconfig validate [MODULE] [--json]        what the core's own validators say about every module and the node keys
    hconfig doctor --json                     the module contract's doctor answer, with the configuration checks
    hconfig status --json                     the module contract's status answer (the core's verbs reachable)
    hconfig version

The classes are `node:<key>` (the node files), `x-<module>:<key>` with scope `node` (module class) and `core:<key>` or
`x-<module>:<key>` with scope `fleet` or `fleet-node` (governed). Every value is the core's answer: this program runs
`hv config schema|show|node list --json` and `hive-mind module list --json` and `module config <name> schema|list --json`
as subprocesses and merges nothing itself. It holds no key, reads no passphrase and opens no socket. `set` and `unset` write
only through the core's own verbs (`hv config node set`, `hive-mind module config <name> set|unset`), validate before
they start one, serialize on one lock, and append a line to a local audit file. A signed write is the core's: it runs
`module config set --non-interactive` and the core signs through the owner-unlock agent or refuses with exit 5, which is
`owner-locked` here (exit 5); no passphrase ever reaches this program. Secrets print as `********`, are accepted only on
stdin, and a refusal never carries a value. Exit codes: 0 ok, 1 refused (nothing changed), 2 usage, 5 owner key locked.
"""

import argparse
import calendar
import fcntl
import hashlib
import json
import os
import re
import shlex
import shutil
import stat
import subprocess
import sys
import time

VERSION = "0.1.0-dev"
SCHEMA = 1
MASK = "********"
CORE_TIMEOUT = 30
# The three owner variables of the core's SCRUBBED_ENV. HIVE_KEY_DIR is a path, not a secret, and is passed through.
OWNER_ENV = ("HIVE_OWNER_PASSPHRASE", "HIVE_OWNER_KEY_PASSPHRASE", "HIVE_OWNER_SEED")
AUTH_SHAPED = re.compile(r"sync_auth|bind")
MODULE_NAME = re.compile(r"[a-z0-9][a-z0-9_-]*\Z")
CLASSES = ("node", "module", "governed")
IDENTIFYING_WARNING = "identifying: a fleet value is journaled and visible to every admitted device for good"


class Refused(Exception):
    def __init__(self, code, message, hint="", key=None, status=1):
        super().__init__(message)
        self.code, self.message, self.hint, self.key, self.status = code, message, hint, key, status


# ── the core, as subprocesses ─────────────────────────────────────────────────────────────────────

def _program(which):
    """`hv` (the data plane) or `hive-mind` (the control plane): `HCONFIG_HV` / `HCONFIG_HIVE_MIND` name one, as an
    argv (split, never a shell); else it is looked up on PATH."""
    override = os.environ.get("HCONFIG_" + which.upper().replace("-", "_"))
    if override:
        return shlex.split(override)
    found = shutil.which(which)
    if not found:
        raise Refused("core-failed", f"`{which}` is not on PATH", "install the core, or put its bin directory on PATH")
    return [found]


def _safe_line(text):
    """The first stderr line of a core verb, only when it cannot be carrying a value."""
    for line in (text or "").splitlines():
        line = "".join(c for c in line.strip() if c.isprintable())[:200]
        if line and not re.search(r"[=\"'`]|\*{4}", line):
            return line
        break
    return ""


def _child_env():
    return {k: v for k, v in os.environ.items() if k not in OWNER_ENV}


def core_run(which, *args, stdin_text=None):
    """Run one core verb: (returncode, stdout, stderr). stdin is closed unless `stdin_text` is given (a secret goes
    this way and never on argv). Never interactive; the owner variables are gone from the child's environment."""
    argv = _program(which) + list(args)
    try:
        r = subprocess.run(argv, input=stdin_text, stdin=None if stdin_text is not None else subprocess.DEVNULL,
                           capture_output=True, text=True, env=_child_env(), timeout=CORE_TIMEOUT)
    except (OSError, subprocess.SubprocessError) as e:
        raise Refused("core-failed", f"`{which} {' '.join(args[:3])}` did not run: {type(e).__name__}") from None
    return r.returncode, r.stdout, r.stderr


def _verb(which, args):
    return f"{which} {' '.join(a for a in args if a != '--json')[:60]}"


def core(which, *args):
    """Run one read verb of the core and return its JSON."""
    rc, out, err = core_run(which, *args)
    if rc != 0:
        tail = _safe_line(err)
        raise Refused("core-failed", f"`{_verb(which, args)}` exited {rc}" + (f": {tail}" if tail else ""),
                      "this core may predate the 4.0 config verbs" if rc == 2 else "run it by hand to see the full message")
    try:
        return json.loads(out)
    except ValueError:
        raise Refused("core-failed", f"`{_verb(which, args)}` did not print JSON", "is the core 4.0 or newer?") from None


# ── records ───────────────────────────────────────────────────────────────────────────────────────

def _kind(core_type, choices=None):
    if choices:
        return "enum"
    return {"str": "string"}.get(core_type, core_type)


def _bounds(rec, spec):
    if spec.get("type") == "enum" or spec.get("choices") or spec.get("values"):
        rec["values"] = list(spec.get("choices") or spec.get("values"))
    for b in ("min", "max"):
        if b in spec:
            rec[b] = spec[b]


def _record(id_, cls, scope, kind, spec, *, secret=False, identifying=False, visibility, writable_by, write_via):
    rec = {"id": id_, "class": cls, "scope": scope, "type": kind, "default": MASK if secret and spec.get("default")
           is not None else spec.get("default")}
    _bounds(rec, spec)
    rec.update(description=spec.get("description", ""), secret=bool(secret), identifying=bool(identifying),
               visibility="operator" if secret else visibility, writable_by=writable_by, write_via=write_via,
               warnings=[IDENTIFYING_WARNING] if identifying and scope != "node" else [],
               set=False, source=None, value=None, set_by=None)
    return rec


def _fill(rec, value, source):
    """Attach the core's merged value and where it came from; a secret is masked here whatever the core sent."""
    rec["source"] = source
    rec["set"] = source not in (None, "default")
    if rec["secret"]:
        rec["value"] = MASK if rec["set"] else None
    elif source == "env" and AUTH_SHAPED.search(rec["id"]):
        rec["value"] = MASK
    else:
        rec["value"] = value


def _node_records(schema, rows):
    by_id = {r.get("id"): r for r in rows}
    out = []
    for spec in schema:
        key = spec["id"]
        rec = _record(f"node:{key}", "node", "node", _kind(spec.get("type"), spec.get("choices")), spec,
                      visibility="operator", writable_by="operator", write_via=f"hv config node set {key} <value>")
        rec["env"] = by_id.get(key, {}).get("env")
        row = by_id.get(key)
        if row is not None:
            _fill(rec, row.get("value"), row.get("source"))
        out.append(rec)
    return out


def _governed_records(schema, show_rows):
    by_id = {r.get("id"): r for r in show_rows}
    out = []
    for spec in schema:
        key = spec["id"]
        rec = _record(f"core:{key}", "governed", "fleet", _kind(spec.get("type"), spec.get("choices")), spec,
                      visibility="viewer", writable_by="owner", write_via=f"hive-mind config set {key} <value>")
        row = by_id.get(key)
        if row is not None:
            _fill(rec, row.get("value"), row.get("source"))
            rec["set_by"] = row.get("set_by")
        out.append(rec)
    return out


def _template_matches(template, key):
    t, k = template.split("."), key.split(".")
    return len(t) == len(k) and all(a == b or (a.startswith("{") and a.endswith("}")) for a, b in zip(t, k))


def _write_via(module, key, scope, secret):
    base = f"hive-mind module config {module} set {key} "
    tail = {"node": "", "fleet": " --fleet", "fleet-node": " --fleet-node <device>"}[scope]
    return base + ("--stdin" if secret else "<value>") + tail


def _module_records(module, schema, rows):
    by_key = {r.get("key"): r for r in rows}
    out = []
    for key in sorted(schema):
        spec = schema[key]
        scope = spec.get("scope", "node")
        governed = scope != "node"
        secret, ident = bool(spec.get("secret")), bool(spec.get("identifying"))
        kw = dict(secret=secret, identifying=ident, visibility="viewer" if governed else "operator",
                  writable_by="owner" if governed else "operator", write_via=_write_via(module, key, scope, secret))
        cls = "governed" if governed else "module"
        if "{" in key:
            tpl = _record(f"x-{module}:{key}", cls, scope, spec.get("type", "string"), spec, **kw)
            tpl["template"] = True
            out.append(tpl)
            for rk in sorted(r for r in by_key if r not in schema and _template_matches(key, r)):
                inst = _record(f"x-{module}:{rk}", cls, scope, spec.get("type", "string"), spec,
                               **{**kw, "write_via": _write_via(module, rk, scope, secret)})
                inst["instance_of"] = tpl["id"]
                _fill(inst, by_key[rk].get("value"), by_key[rk].get("source"))
                out.append(inst)
            continue
        rec = _record(f"x-{module}:{key}", cls, scope, spec.get("type", "string"), spec, **kw)
        row = by_key.get(key)
        if row is not None:
            _fill(rec, row.get("value"), row.get("source"))
        out.append(rec)
    return out


class Registry:
    """The union of the three sources, as KeyRecords, in a fixed order: node keys, core keys, then modules by name."""

    def __init__(self, prefix=""):
        self.records, self.warnings, self.governance, self.modules = [], [], {}, []
        want_node = not prefix.startswith(("core:", "x-"))
        want_governed = not prefix.startswith(("node:", "x-"))
        want_modules = not prefix.startswith(("node:", "core:"))
        only = prefix[2:prefix.index(":")] if prefix.startswith("x-") and ":" in prefix else None
        if want_node or want_governed:
            schema = core("hv", "config", "schema", "--json")
            if want_node:
                nodes = core("hv", "config", "node", "list", "--json")
                self.records += _node_records(schema.get("node", []), nodes.get("keys", []))
            if want_governed:
                show = core("hv", "config", "show", "--json")
                self.governance = show.get("governance") or {}
                self.records += _governed_records(schema.get("governed", []), show.get("governed", []))
        if want_modules:
            listed = core("hive-mind", "module", "list", "--json").get("modules", [])
            self.modules = sorted(m["name"] for m in listed if MODULE_NAME.match(str(m.get("name", ""))))
            for m in sorted(listed, key=lambda m: str(m.get("name"))):
                name = str(m.get("name", ""))
                if not MODULE_NAME.match(name) or (only and name != only) or not m.get("config_schema"):
                    continue
                try:
                    sch = core("hive-mind", "module", "config", name, "schema", "--json")
                    rows = core("hive-mind", "module", "config", name, "list", "--json")
                except Refused as e:
                    self.warnings.append({"module": name, "message": e.message})
                    continue
                self.records += _module_records(name, sch, rows)

    def select(self, prefix="", cls=None):
        return [r for r in self.records if r["id"].startswith(prefix) and (cls is None or r["class"] == cls)]

    def get(self, id_):
        for r in self.records:
            if r["id"] == id_:
                return r
        if id_.startswith("x-") and ":" in id_ and id_[2:id_.index(":")] not in self.modules:
            raise Refused("not-installed", f"no module {id_[2:id_.index(':')]!r} is installed",
                          "hive-mind module list shows what is installed", id_)
        raise Refused("unknown-key", f"no such key: {id_}", "hconfig schema lists every key", id_)


def _resolve(reg, id_):
    """The record for `id_`, or, for a concrete key that matches a template and is not set yet, a record built from it."""
    try:
        return reg.get(id_)
    except Refused as e:
        if e.code != "unknown-key" or not id_.startswith("x-") or ":" not in id_:
            raise
        mod, _, key = id_[2:].partition(":")
        for t in reg.records:
            if t.get("template") and t["id"].startswith(f"x-{mod}:") and _template_matches(t["id"].split(":", 1)[1], key):
                inst = json.loads(json.dumps(t))
                inst.pop("template")
                inst.update(id=id_, instance_of=t["id"], write_via=_write_via(mod, key, t["scope"], t["secret"]))
                return inst
        raise


def schema_view(rec):
    """A record without its value: what `hconfig schema` prints."""
    return {k: v for k, v in rec.items() if k not in ("value", "source", "set", "set_by")}


# ── explain ───────────────────────────────────────────────────────────────────────────────────────

def derive(rec, governance):
    """The consequence lines for one record, from the record and `config show`'s governance block alone."""
    out = []
    if rec["secret"]:
        out.append({"code": "secret", "text": "a secret: its value is never shown and is only ever given on stdin"})
    if rec.get("env") and rec["source"] == "env":
        out.append({"code": "env-override", "text": f"{rec['env']} is set and overrides the node file; a file value "
                                                    "is ignored while it is"})
    if rec["id"] == "core:cap_self" and rec["value"] is not None:
        principals = {a.get("principal") for a in governance.get("admitted", [])}
        if len(principals) == 1:
            out.append({"code": "single-principal", "text": f"single-principal hive: cap_self ({rec['value']}) binds "
                                                            "on every corroborated fact"})
    if rec["id"] == "core:quorum_m" and rec["value"] == 0:
        out.append({"code": "elections-off", "text": "quorum_m = 0: elections are off, so the owner is never replaced "
                                                     "by a vote"})
    if rec["id"] == "core:dead_man_days" and governance.get("quorum_m") == 0:
        out.append({"code": "dead-man-inert", "text": "quorum_m = 0, so dead_man_days has no effect"})
    if rec["id"] in ("node:port", "node:bind") or rec["id"].startswith("node:dashboard_viewer"):
        out.append({"code": "restart", "text": "read when the service starts: restart it after a change"})
    for w in rec["warnings"]:
        out.append({"code": "identifying", "text": w})
    return out


# ── writes ────────────────────────────────────────────────────────────────────────────────────────

VALUE_MAX = 4096
INT_TEXT = re.compile(r"-?[0-9]{1,18}\Z")
SOURCE_NAME = re.compile(r"[a-z0-9][a-z0-9_.-]{0,31}\Z")
LOCK_WAIT = 30
# Node-file keys the core owns but gates on the owner's public key: read-only here, with the command to run by hand.
OWNER_ONLY_NODE = {"owner_quota": "hive-mind module quota <module> --per-hour <n> --per-day <n>"}


def hive_home():
    return os.path.abspath(os.environ.get("HIVE_HOME") or os.path.expanduser("~/projects/hive-mind"))


def _state_dir():
    """`$HIVE_HOME/hconfig/`: ours, 0700, never a symlink."""
    path = os.path.join(hive_home(), "hconfig")
    os.makedirs(hive_home(), exist_ok=True)
    try:
        os.mkdir(path, 0o700)
    except FileExistsError:
        pass
    st = os.lstat(path)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.getuid():
        raise Refused("read-only", "the hconfig state directory is not a directory of this user",
                      "remove it or fix its owner; hconfig will not write into it")
    if st.st_mode & 0o077:
        os.chmod(path, 0o700)
    return path


def _open_private(path, flags):
    """Open (creating 0600) a file of ours: no symlink followed, nothing that is not a regular file of this user."""
    try:
        fd = os.open(path, flags | os.O_CREAT | os.O_NOFOLLOW | os.O_CLOEXEC, 0o600)
    except OSError as e:
        raise Refused("read-only", f"an hconfig state file cannot be opened ({e.strerror})", "remove it") from None
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid():
        os.close(fd)
        raise Refused("read-only", "an hconfig state file is not a regular file of this user", "remove it")
    if st.st_mode & 0o077:
        os.fchmod(fd, 0o600)
    return fd


class Locked:
    """One exclusive `flock` under the state directory: two writes (two dashboard requests) never interleave."""

    def __enter__(self):
        self.fd = _open_private(os.path.join(_state_dir(), "lock"), os.O_RDWR)
        deadline = time.monotonic() + LOCK_WAIT
        while True:
            try:
                fcntl.flock(self.fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return self
            except BlockingIOError:
                if time.monotonic() > deadline:
                    os.close(self.fd)
                    raise Refused("core-failed", "another hconfig write holds the lock", "try again") from None
                time.sleep(0.02)

    def __exit__(self, *exc):
        os.close(self.fd)                      # closing releases the flock


def audit_open():
    """The audit file, opened (and checked) before a write starts, so a refusal here means nothing has changed."""
    return _open_private(os.path.join(_state_dir(), "audit.jsonl"), os.O_WRONLY | os.O_APPEND)


def audit_write(fd, rec, action, ok, code=None, old=None, new=None):
    """One line per write hconfig performs: a local convenience record, not evidence (any process of this user can
    edit it). Never a value for a secret."""
    who = os.environ.get("HCONFIG_SOURCE", "cli")
    line = {"ts": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()), "id": rec["id"], "class": rec["class"],
            "action": action, "source": who if SOURCE_NAME.match(who) else "other", "uid": os.getuid(),
            "pid": os.getpid(), "ok": ok, "error": {"code": code} if code else None}
    if not rec["secret"]:
        line.update(old=old, new=new)
    try:
        os.write(fd, (json.dumps(line) + "\n").encode())
    finally:
        os.close(fd)


def _parse_list(text):
    try:
        val = json.loads(text) if text.lstrip().startswith("[") else [x.strip() for x in text.split(",")]
    except ValueError:
        val = None
    val = [x for x in val if x != ""] if isinstance(val, list) else None
    if val is None or not all(isinstance(x, str) and 0 < len(x) <= 256 and not any(c.isspace() for c in x) for x in val):
        return None
    return sorted(set(val))


def validate(rec, text):
    """The value the layer would hold, or a `validation` refusal. Type, enum and bounds only (the core checks the rest);
    no message carries the value."""
    def bad(why):
        return Refused("validation", f"{rec['id']}: {why}", "hconfig get shows the type and range", rec["id"])
    if len(text) > VALUE_MAX or not text.isprintable():
        raise bad("not printable text within the value limit")
    kind = rec["type"]
    if kind == "int":
        if not INT_TEXT.match(text.strip() if rec["class"] == "node" else text):
            raise bad("not a whole number")
        try:
            n = int(text.strip())
        except ValueError:
            raise bad("not a whole number") from None
        if ("min" in rec and n < rec["min"]) or ("max" in rec and n > rec["max"]):
            raise bad(f"outside {rec.get('min', '-inf')}..{rec.get('max', 'inf')}")
        return n if rec["class"] == "node" else text
    if kind == "float":
        try:
            x = float(text)
        except ValueError:
            raise bad("not a number") from None
        if x != x or x in (float("inf"), float("-inf")) or ("min" in rec and x < rec["min"]) or ("max" in rec and x > rec["max"]):
            raise bad("not a finite number within the range")
        return x
    if kind == "enum":
        val = text.strip().lower() if rec["class"] == "node" else text
        if val not in rec["values"]:
            raise bad("not one of " + ", ".join(rec["values"]))
        return val
    if kind == "bool":
        if text not in ("true", "false"):
            raise bad("not true or false")
    elif kind == "list":
        val = _parse_list(text)
        if val is None:
            raise bad("not a comma-separated list or a JSON list of strings without spaces")
        return val
    elif kind == "string" and rec["class"] != "node" and "max" in rec and len(text) > rec["max"]:
        raise bad(f"longer than {rec['max']}")
    return text.strip() if rec["class"] == "node" else text


def _core_error(rc, out, err):
    """The refusal text of a failed write verb: one safe line, never a value."""
    line = _safe_line(err)
    if not line:
        try:
            line = _safe_line(str(json.loads(out).get("error", "")))
        except (ValueError, AttributeError):
            line = ""
    return f"the core refused (exit {rc})" + (f": {line}" if line else "")


DEVICE_ID = re.compile(r"k1:[0-9a-f]{16}\Z")


def agent_dirs():
    """The two directories the owner-unlock agent's socket can be in: the one this environment looks in first, and the
    other. The core's rule: `$XDG_RUNTIME_DIR/hive-mind` if that is absolute, else `$TMPDIR/hive-mind-<uid>`."""
    xdg = os.environ.get("XDG_RUNTIME_DIR")
    tmp = os.path.join(os.environ.get("TMPDIR") or "/tmp", f"hive-mind-{os.getuid()}")
    xdg = os.path.join(xdg, "hive-mind") if xdg and os.path.isabs(xdg) else None
    return (xdg or tmp), (tmp if xdg else None)


def this_device():
    rc, out, _ = core_run("hv", "whoami")
    m = re.search(r"^device:\s+(k1:[0-9a-f]{16})\b", out, re.M) if rc == 0 else None
    if not m:
        raise Refused("core-failed", "could not read this device's id from `hv whoami`", "run it by hand")
    return m.group(1)


def _owner_locked(rec, mod):
    looked, _ = agent_dirs()
    return Refused("owner-locked", f"the owner key is locked, or the unlock agent would not sign {rec['id']} (module {mod})",
                   f"run `hive-mind owner unlock --module {mod}` on your own terminal; the agent socket was looked for in "
                   f"{looked}", rec["id"], status=5)


def _run_write(rec, action, value, device=None):
    """Run the one core verb that writes `rec`'s layer. Returns (changed, note)."""
    key = rec["id"].split(":", 1)[1]
    if rec["class"] == "node":
        rc, out, err = core_run("hv", "config", "node", "set", "--json", "--", key, str(value))
        note = None
        if rc == 0:
            try:
                note = json.loads(out).get("note")
            except (ValueError, AttributeError):
                pass
    else:
        mod = rec["id"][2:].split(":", 1)[0]
        if rec["class"] == "governed":          # signed: the core signs through the agent or refuses with exit 5
            layer = ["--fleet"] if rec["scope"] == "fleet" else ["--fleet-node", device]
            rc, out, err = core_run("hive-mind", "module", "config", "--non-interactive", *layer, "--", mod, "set", key,
                                    value)
            if rc == 5:
                raise _owner_locked(rec, mod)
            if rc == 0 and ("nothing signed" in out or "nothing changed" in out):
                return False, None              # the core compared the full key and signed nothing
            if rc != 0:
                raise Refused("core-failed", _core_error(rc, out, err), "run the core verb by hand to see more", rec["id"])
            return True, None
        if action == "unset":
            rc, out, err = core_run("hive-mind", "module", "config", mod, "unset", key)
        elif rec["secret"]:                    # a secret goes to the core on stdin and is never in any argv
            rc, out, err = core_run("hive-mind", "module", "config", mod, "set", key, "--stdin", "--non-interactive",
                                    stdin_text=value + "\n")
        else:
            rc, out, err = core_run("hive-mind", "module", "config", "--non-interactive", "--", mod, "set", key, value)
        note = None
    if rc != 0:
        raise Refused("core-failed", _core_error(rc, out, err), "run the core verb by hand to see more", rec["id"])
    if rec["class"] != "node" and "nothing changed" in out:
        return False, None                     # the core compared the node layer itself and wrote nothing
    return True, note


def _same(rec, canon):
    if rec["secret"]:
        return False                           # a masked value cannot be compared: the core decides
    v = rec["value"]
    return v == canon or (rec["class"] != "node" and str(v) == str(canon))


def do_write(args, action, value):
    """set / unset: refuse what the record says is not writable, validate, then (under one lock) compare the layer being
    written and run the core verb. Returns (record after the write, changed, note)."""
    if args.id.startswith("node:") and args.id[5:] in OWNER_ONLY_NODE:
        raise Refused("owner-only", f"{args.id} is changed by the owner, not here", OWNER_ONLY_NODE[args.id[5:]], args.id)
    rec = _resolve(Registry(args.id), args.id)
    if rec.get("template"):
        raise Refused("validation", f"{args.id} is a template, not a key", "name a concrete key such as "
                      + args.id.replace("{", "<").replace("}", ">"), args.id)
    if action == "set" and rec["secret"] and args.value is not None:
        raise Refused("secret-on-argv", f"{args.id} is a secret and is never taken on a command line",
                      "pass it on stdin with --stdin", args.id)
    if rec["class"] == "governed" and args.id.startswith("core:"):
        raise Refused("owner-only", f"{args.id} is changed by the owner, signed, not by hconfig 0.1", rec["write_via"], args.id)
    if rec["class"] == "governed" and action == "unset":
        raise Refused("read-only", f"{args.id} is a fleet value: it cannot be removed, only set again", rec["write_via"], args.id)
    device = getattr(args, "device", None)
    if device is not None and (rec["scope"] != "fleet-node" or not DEVICE_ID.match(device)):
        raise Refused("validation", "--device names a device (k1:<16 hex>) and only applies to a fleet-node key",
                      "omit it to write this device's value", args.id)
    if rec["class"] == "node" and action == "unset":
        raise Refused("read-only", f"{args.id} cannot be unset: the core has no verb for it", "set it to its default", args.id)
    if rec["class"] == "node" and rec["source"] == "env":
        raise Refused("env-overridden", f"{rec['env']} is set in the environment and overrides {args.id}",
                      "unset the variable; hconfig never writes an environment", args.id)
    canon = validate(rec, value) if action == "set" else None
    with Locked():
        rec = _resolve(Registry(args.id), args.id)
        mine = True
        if rec["scope"] == "fleet-node":
            me = this_device()
            device = device or me
            mine = device == me
        # The layer being written: the node file, the module's node config, or the journal's own entry for the full key.
        # The merged answer is this device's, so another device's fleet-node entry cannot be compared here: the core
        # compares it (and signs nothing if it is equal).
        in_layer = mine and rec["source"] == rec["scope"]
        if (action == "set" and in_layer and _same(rec, canon)) or (action == "unset" and not in_layer):
            return rec, False, None
        old = rec["value"] if in_layer else None
        log = audit_open()
        try:
            changed, note = _run_write(rec, action, value, device)
        except Refused as e:
            audit_write(log, rec, action, False, e.code, old, value)
            raise
        if changed:
            audit_write(log, rec, action, True, None, old, None if action == "unset" else canon)
        else:
            os.close(log)                      # nothing was written, so there is nothing to record
    return _resolve(Registry(args.id), args.id), changed, note


# ── output ────────────────────────────────────────────────────────────────────────────────────────

def _show(v):
    return "-" if v is None else (v if isinstance(v, str) else json.dumps(v))


def _table(rows):
    if not rows:
        return ""
    widths = [max(len(r[i]) for r in rows) for i in range(len(rows[0]) - 1)]
    return "\n".join("  ".join([c.ljust(w) for c, w in zip(r, widths)] + [r[-1]]) for r in rows)


def text_list(recs):
    return _table([[r["id"], _show(r["value"] if r["set"] else r["default"]), f"({r['source'] or 'unset'})"]
                   for r in recs])


def text_schema(recs):
    return _table([[r["id"], f"{r['class']}/{r['scope']}", r["type"] + ("*" if r.get("template") else ""),
                    r["description"]] for r in recs])


def text_record(rec):
    lines = [f"{rec['id']}  [{rec['class']}, scope {rec['scope']}, {rec['type']}]", f"  {rec['description']}"]
    lines.append(f"  value: {_show(rec['value'])}  ({rec['source'] or 'unset'})   default: {_show(rec['default'])}")
    if "values" in rec:
        lines.append("  one of: " + ", ".join(rec["values"]))
    if "min" in rec or "max" in rec:
        lines.append(f"  range: {_show(rec.get('min'))} .. {_show(rec.get('max'))}")
    lines.append(f"  visible to: {rec['visibility']}   written by: {rec['writable_by']}   via: {rec['write_via']}")
    if rec["set_by"]:
        lines.append(f"  set by: {rec['set_by'].get('device_id')} at {rec['set_by'].get('ts')} ({rec['set_by'].get('sid')})")
    lines += [f"  warning: {w}" for w in rec["warnings"]]
    return "\n".join(lines)


def emit(args, payload, text):
    if args.json:
        print(json.dumps({"schema": SCHEMA, "ok": True, **payload}, indent=2))
    elif text:
        print(text)


def refuse(args, e):
    if args.json:
        print(json.dumps({"schema": SCHEMA, "ok": False, "error": {"code": e.code, "id": e.key, "message": e.message,
                                                                    "hint": e.hint}}, indent=2))
    else:
        print(f"hconfig: {e.message}" + (f" ({e.hint})" if e.hint else ""), file=sys.stderr)
    return e.status


# ── verbs ─────────────────────────────────────────────────────────────────────────────────────────

def cmd_schema(args):
    reg = Registry(args.prefix)
    recs = [schema_view(r) for r in reg.select(args.prefix)]
    emit(args, {"keys": recs, "warnings": reg.warnings}, text_schema(recs))


def cmd_list(args):
    reg = Registry(args.prefix)
    recs = reg.select(args.prefix, args.cls)
    emit(args, {"keys": recs, "warnings": reg.warnings}, text_list(recs))


def cmd_get(args):
    rec = Registry(args.id).get(args.id)
    emit(args, {"key": rec}, text_record(rec))


def cmd_explain(args):
    reg = Registry(args.id)
    rec = reg.get(args.id)
    derived = derive(rec, reg.governance)
    text = text_record(rec) + ("\n  derived:\n" + "\n".join(f"    - {d['text']}" for d in derived) if derived else "")
    emit(args, {"key": rec, "derived": derived}, text)


def _core_problem():
    """None when the core's config verbs answer, else one line saying why not (no value can be in it)."""
    try:
        core("hv", "config", "schema", "--json")
    except Refused as e:
        return e.message, e.hint
    return None


def cmd_status(args):
    """The contract's status envelope: hconfig has no service, so it is `ok` when the core it reads from answers."""
    bad = _core_problem()
    print(json.dumps({"schema": 1, "state": "degraded" if bad else "ok", "version": VERSION,
                      "problems": [bad[0]] if bad else [], "detail": {}}))


# ── validate and doctor ───────────────────────────────────────────────────────────────────────────

def _text(msg):
    return "".join(c for c in str(msg) if c.isprintable())[:300]


def run_validate(module=None):
    """(errors, warnings) as `[{id, message}]`: the core's own validator for each installed module, and the node keys'
    current values against the core's schema. Messages name a key and a rule, never a value."""
    errors, warnings = [], []
    mods = sorted(m["name"] for m in core("hive-mind", "module", "list", "--json").get("modules", [])
                  if MODULE_NAME.match(str(m.get("name", ""))) and m.get("config_schema"))
    if module is not None:
        if module not in {m["name"] for m in core("hive-mind", "module", "list", "--json").get("modules", [])}:
            raise Refused("not-installed", f"no module {module!r} is installed", "hive-mind module list shows what is installed",
                          f"x-{module}")
        mods = [module] if module in mods else []
    for name in mods:
        res = core("hive-mind", "module", "config", name, "validate", "--json")
        errors += [{"id": f"x-{name}", "message": _text(m)} for m in res.get("errors", [])]
        warnings += [{"id": f"x-{name}", "message": _text(m)} for m in res.get("warnings", [])]
    if module is None:
        reg = Registry("node:")
        for rec in reg.select("node:"):
            if rec["source"] != "node" or rec["value"] is None:
                continue
            text = ",".join(rec["value"]) if isinstance(rec["value"], list) else str(rec["value"])
            try:
                validate(rec, text)
            except Refused as e:
                errors.append({"id": rec["id"], "message": _text(e.message.split(": ", 1)[-1])})
    return errors, warnings


def cmd_validate(args):
    errors, warnings = run_validate(args.module)
    ok = not errors
    if args.json:
        print(json.dumps({"schema": SCHEMA, "ok": ok, "errors": errors, "warnings": warnings}, indent=2))
    else:
        for e in errors:
            print(f"error: {e['id']}: {e['message']}")
        for w in warnings:
            print(f"warning: {w['id']}: {w['message']}")
        if ok and not warnings:
            print("ok")
    return 0 if ok else 1


def _mode(path):
    try:
        return stat.S_IMODE(os.lstat(path).st_mode)
    except OSError:
        return None


def _in_range(rec):
    """False when a governed value is outside what the core's table accepts now (an entry from an older table)."""
    v = rec["value"]
    if v is None or rec["source"] in (None, "default"):
        return True
    if "values" in rec and v not in rec["values"]:
        return False
    if isinstance(v, (int, float)) and not isinstance(v, bool):
        return not (("min" in rec and v < rec["min"]) or ("max" in rec and v > rec["max"]))
    return True


def _agent_socket_row(row):
    """The owner agent's socket lives under one of two directories. If it is in the one this process would not look in,
    every governed write from here says `owner-locked` while the agent is unlocked."""
    h = hashlib.sha256(os.path.realpath(hive_home()).encode()).hexdigest()[:12]
    name = f"owner-agent-{h}.sock"
    mine, other = agent_dirs()
    if other is None:
        xdg = os.environ.get("XDG_RUNTIME_DIR")          # XDG is unset here: the other place to look is a runtime dir
        cands = [os.path.join(f"/run/user/{os.getuid()}", "hive-mind")]
        other = cands[0] if xdg is None else None
    if os.path.exists(os.path.join(mine, name)) or other is None or not os.path.exists(os.path.join(other, name)):
        row("ok", "agent-socket-dir", f"the owner agent's socket, if there is one, is where this process looks ({mine})")
    else:
        row("warn", "agent-socket-dir", f"the owner agent's socket is in {other}, not in {mine}, where this process looks",
            "run hconfig with the same XDG_RUNTIME_DIR as the terminal that ran `hive-mind owner unlock`")


def _key_dir_row(row):
    env = os.environ.get("HIVE_KEY_DIR")
    pointer = os.path.join(hive_home(), ".key-dir")
    try:
        with open(pointer) as f:
            recorded = f.read().strip()
    except OSError:
        recorded = None
    if env and (recorded is None or os.path.realpath(env) != os.path.realpath(recorded)):
        row("warn", "key-dir", "HIVE_KEY_DIR is set and a child without it would resolve a different key directory"
            if recorded else "HIVE_KEY_DIR is set and the hive has no .key-dir file: a child without it would resolve "
            "a different key directory", "set HIVE_KEY_DIR in every shell and unit that runs hconfig, or remove it")
    else:
        row("ok", "key-dir", "the key directory is the same with or without HIVE_KEY_DIR")


def _systemd_started(unit="hive-sync"):
    exe = shutil.which("systemctl")
    if not exe:
        return None
    try:
        r = subprocess.run([exe, "--user", "show", unit, "--property=ActiveEnterTimestamp", "--value"],
                           stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=5, env=_child_env())
        out = r.stdout.strip()
        if r.returncode != 0 or not out:
            return None
        d = subprocess.run(["date", "-d", out, "+%s"], stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=5)
        return float(d.stdout.strip()) if d.returncode == 0 else None
    except (OSError, subprocess.SubprocessError, ValueError):
        return None


def _last_audit_ts():
    try:
        with open(os.path.join(hive_home(), "hconfig", "audit.jsonl")) as f:
            lines = f.read().splitlines()
        return calendar.timegm(time.strptime(json.loads(lines[-1])["ts"], "%Y-%m-%dT%H:%M:%SZ")) if lines else None
    except (OSError, ValueError, KeyError, IndexError):
        return None


def run_doctor():
    results = []

    def row(level, check, message, hint=None):
        r = {"level": level, "check": check, "message": _text(message)}
        if hint:
            r["fix_hint"] = _text(hint)
        results.append(r)

    bad = _core_problem()
    if bad:
        row("warn", "core-verbs", bad[0], bad[1])
        return results
    row("ok", "core-verbs", "the core's config verbs answer")
    reg = Registry("")
    errors, warnings = run_validate()
    for e in errors:
        row("warn", "config-invalid", f"{e['id']}: {e['message']}", "hconfig validate shows the same findings")
    for w in warnings:
        row("warn", "config-unknown-key" if "not in the schema" in w["message"] else "config-warning",
            f"{w['id']}: {w['message']}", "hconfig validate shows the same findings")
    if not errors and not warnings:
        row("ok", "config", "every module's config and the node keys validate")
    shadow = [r for r in reg.records if r["class"] == "node" and r["source"] == "env"]
    for r in shadow:
        row("warn", "env-override", f"{r['id']} is overridden by {r['env']}, which beats the node file",
            f"unset {r['env']} to use the file's value")
    if not shadow:
        row("ok", "env-override", "no node key is overridden by the environment")
    old = [r["id"] for r in reg.records if r["id"].startswith("core:") and not _in_range(r)]
    for i in old:
        row("warn", "governed-range", f"{i} holds a value the core's table no longer accepts (an old entry)",
            "the owner can set it again with hive-mind config set")
    if not old:
        row("ok", "governed-range", "every governed value is inside the core's table")
    _key_dir_row(row)
    _agent_socket_row(row)
    state = os.path.join(hive_home(), "hconfig")
    bad_modes = [(p, m) for p, want in ((state, 0o700), (os.path.join(state, "audit.jsonl"), 0o600)) if os.path.exists(p)
                 for m in [_mode(p)] if m is not None and m != want]
    for p, m in bad_modes:
        row("warn", "audit-file", f"{os.path.basename(p)} has mode {m:04o}", f"chmod {'700' if p == state else '600'} {p}")
    if not bad_modes:
        row("ok", "audit-file", "the audit directory and file are private")
    peers = os.path.join(hive_home(), ".peers.json")
    try:
        mtime = os.stat(peers).st_mtime
    except OSError:
        mtime = None
    last = _last_audit_ts()
    if mtime is not None and last is not None and mtime > last + 5:
        row("warn", "node-file-audit-gap", "the node file changed after hconfig's last audit line: it was edited directly",
            "changes made with a core verb are not in the audit file")
    else:
        row("ok", "node-file-audit-gap", "no node-file change outside hconfig is known")
    started = _systemd_started()
    if mtime is not None and started is not None and mtime > started + 1:
        row("warn", "peers-reread", "the sync daemon has not restarted since the node file changed",
            "systemctl --user restart hive-sync")
    else:
        row("ok", "peers-reread", "the sync daemon has seen the node file as it is, or its start time is unknown")
    return results[:100]


def cmd_doctor(args):
    print(json.dumps({"schema": 1, "results": run_doctor()}))
    return 0


def _write_verb(action):
    def run_it(args):
        value = None
        if action == "set":
            if args.stdin and args.value is not None:
                raise UsageError("give the value or --stdin, not both")
            if args.stdin:
                value = sys.stdin.readline().rstrip("\r\n")
            elif args.value is not None:
                value = args.value
            else:
                raise UsageError("set needs a value, or --stdin")
        rec, changed, note = do_write(args, action, value)
        payload = {"id": rec["id"], "action": action, "changed": changed, "key": rec, "warnings": rec["warnings"]}
        if note:
            payload["note"] = note
        verb = "unset" if action == "unset" else "set"
        emit(args, payload, f"{verb} {rec['id']}" + ("" if changed else " (nothing to change)")
             + (f"\n  {note}" if note else ""))
    return run_it


class UsageError(Exception):
    pass


def cmd_version(args):
    print(f"hconfig {VERSION}")


def parser():
    ap = argparse.ArgumentParser(prog="hconfig", description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="verb", required=True)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", help="one JSON object, schema 1")
    p = sub.add_parser("schema", parents=[common], help="every known key, without values")
    p.add_argument("prefix", nargs="?", default="")
    p.set_defaults(fn=cmd_schema)
    p = sub.add_parser("list", parents=[common], help="the records with their merged values")
    p.add_argument("prefix", nargs="?", default="")
    p.add_argument("--class", dest="cls", choices=CLASSES)
    p.set_defaults(fn=cmd_list)
    p = sub.add_parser("get", parents=[common], help="one record")
    p.add_argument("id")
    p.set_defaults(fn=cmd_get)
    p = sub.add_parser("explain", parents=[common], help="one record and what its value means for this hive")
    p.add_argument("id")
    p.set_defaults(fn=cmd_explain)
    p = sub.add_parser("set", parents=[common], help="set a node: key or a node-scope module key")
    p.add_argument("id")
    p.add_argument("value", nargs="?", help="the value (a secret is never taken here: use --stdin)")
    p.add_argument("--stdin", action="store_true", help="read the value, one line, from standard input")
    p.add_argument("--device", help="a fleet-node key: the device (k1:<16 hex>) to set it for; default this device")
    p.add_argument("--non-interactive", action="store_true", help="never prompt (hconfig never does; accepted for hdash)")
    p.set_defaults(fn=_write_verb("set"))
    p = sub.add_parser("unset", parents=[common], help="remove a node-scope module key's value")
    p.add_argument("id")
    p.set_defaults(fn=_write_verb("unset"), stdin=False, value=None, device=None)
    p = sub.add_parser("validate", parents=[common], help="the core's validators over every module and the node keys")
    p.add_argument("module", nargs="?")
    p.set_defaults(fn=cmd_validate)
    for name, fn in (("status", cmd_status), ("doctor", cmd_doctor)):
        p = sub.add_parser(name, parents=[common], help=f"the module contract's {name} answer, JSON")
        p.set_defaults(fn=fn)
    p = sub.add_parser("version")
    p.set_defaults(fn=cmd_version, json=False)
    return ap


def main(argv=None):
    ap = parser()
    args = ap.parse_args(argv)
    try:
        return args.fn(args) or 0
    except UsageError as e:
        ap.error(str(e))
    except Refused as e:
        return refuse(args, e)
    except BrokenPipeError:
        return 0


if __name__ == "__main__":
    sys.exit(main())
