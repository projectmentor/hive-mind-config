#!/usr/bin/env python3
"""hconfig: one registry of every setting a node has, read through the core's own verbs.

    hconfig schema [PREFIX] [--json]          every known key with its schema (no values)
    hconfig list [PREFIX] [--class node|module|governed] [--json]
    hconfig get ID [--json]                   one record
    hconfig explain ID [--json]               the record and what its value means for this hive
    hconfig status --json | doctor --json     the module contract's status and doctor answers (the core's verbs reachable)
    hconfig version

The classes are `node:<key>` (the node files), `x-<module>:<key>` with scope `node` (module class) and `core:<key>` or
`x-<module>:<key>` with scope `fleet` or `fleet-node` (governed). Every value is the core's answer: this program runs
`hv config schema|show|node list --json` and `hive-mind module list --json` and `module config <name> schema|list --json`
as subprocesses and merges nothing itself. It holds no key, reads no passphrase, opens no socket and writes nothing.
Secrets print as `********` and a refusal never carries a value. Exit codes: 0 ok, 1 refused (nothing changed), 2 usage.
"""

import argparse
import json
import os
import re
import shlex
import shutil
import subprocess
import sys

VERSION = "0.1.0-dev"
SCHEMA = 1
MASK = "********"
CORE_TIMEOUT = 30
# The three owner variables of the core's SCRUBBED_ENV. HIVE_KEY_DIR is a path, not a secret, and is passed through.
OWNER_ENV = ("HIVE_OWNER_PASSPHRASE", "HIVE_OWNER_KEY_PASSPHRASE", "HIVE_OWNER_SEED")
AUTH_SHAPED = re.compile(r"sync_auth|bind")
MODULE_NAME = re.compile(r"[a-z0-9][a-z0-9_-]*\Z")
CLASSES = ("node", "module", "governed")
IDENTIFYING_WARNING = "identifying: a fleet value is journaled and visible to every admitted device for good"


class Refused(Exception):
    def __init__(self, code, message, hint="", key=None):
        super().__init__(message)
        self.code, self.message, self.hint, self.key = code, message, hint, key


# ── the core, as subprocesses ─────────────────────────────────────────────────────────────────────

def _program(which):
    """`hv` (the data plane) or `hive-mind` (the control plane): `HCONFIG_HV` / `HCONFIG_HIVE_MIND` name one, as an
    argv (split, never a shell); else it is looked up on PATH."""
    override = os.environ.get("HCONFIG_" + which.upper().replace("-", "_"))
    if override:
        return shlex.split(override)
    found = shutil.which(which)
    if not found:
        raise Refused("core-failed", f"`{which}` is not on PATH", "install the core, or put its bin directory on PATH")
    return [found]


def _safe_line(text):
    """The first stderr line of a core verb, only when it cannot be carrying a value."""
    for line in (text or "").splitlines():
        line = "".join(c for c in line.strip() if c.isprintable())[:200]
        if line and not re.search(r"[=\"'`]|\*{4}", line):
            return line
        break
    return ""


def core(which, *args):
    """Run one read verb of the core and return its JSON. Never interactive: stdin is closed, the owner variables gone."""
    argv = _program(which) + list(args)
    env = {k: v for k, v in os.environ.items() if k not in OWNER_ENV}
    try:
        r = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, text=True, env=env, timeout=CORE_TIMEOUT)
    except (OSError, subprocess.SubprocessError) as e:
        raise Refused("core-failed", f"`{which} {' '.join(args[:3])}` did not run: {type(e).__name__}") from None
    verb = f"{which} {' '.join(a for a in args if a != '--json')}"
    if r.returncode != 0:
        tail = _safe_line(r.stderr)
        raise Refused("core-failed", f"`{verb}` exited {r.returncode}" + (f": {tail}" if tail else ""),
                      "this core may predate the 4.0 config verbs" if r.returncode == 2
                      else "run it by hand to see the full message")
    try:
        return json.loads(r.stdout)
    except ValueError:
        raise Refused("core-failed", f"`{verb}` did not print JSON", "is the core 4.0 or newer?") from None


# ── records ───────────────────────────────────────────────────────────────────────────────────────

def _kind(core_type, choices=None):
    if choices:
        return "enum"
    return {"str": "string"}.get(core_type, core_type)


def _bounds(rec, spec):
    if spec.get("type") == "enum" or spec.get("choices") or spec.get("values"):
        rec["values"] = list(spec.get("choices") or spec.get("values"))
    for b in ("min", "max"):
        if b in spec:
            rec[b] = spec[b]


def _record(id_, cls, scope, kind, spec, *, secret=False, identifying=False, visibility, writable_by, write_via):
    rec = {"id": id_, "class": cls, "scope": scope, "type": kind, "default": MASK if secret and spec.get("default")
           is not None else spec.get("default")}
    _bounds(rec, spec)
    rec.update(description=spec.get("description", ""), secret=bool(secret), identifying=bool(identifying),
               visibility="operator" if secret else visibility, writable_by=writable_by, write_via=write_via,
               warnings=[IDENTIFYING_WARNING] if identifying and scope != "node" else [],
               set=False, source=None, value=None, set_by=None)
    return rec


def _fill(rec, value, source):
    """Attach the core's merged value and where it came from; a secret is masked here whatever the core sent."""
    rec["source"] = source
    rec["set"] = source not in (None, "default")
    if rec["secret"]:
        rec["value"] = MASK if rec["set"] else None
    elif source == "env" and AUTH_SHAPED.search(rec["id"]):
        rec["value"] = MASK
    else:
        rec["value"] = value


def _node_records(schema, rows):
    by_id = {r.get("id"): r for r in rows}
    out = []
    for spec in schema:
        key = spec["id"]
        rec = _record(f"node:{key}", "node", "node", _kind(spec.get("type"), spec.get("choices")), spec,
                      visibility="operator", writable_by="operator", write_via=f"hv config node set {key} <value>")
        rec["env"] = by_id.get(key, {}).get("env")
        row = by_id.get(key)
        if row is not None:
            _fill(rec, row.get("value"), row.get("source"))
        out.append(rec)
    return out


def _governed_records(schema, show_rows):
    by_id = {r.get("id"): r for r in show_rows}
    out = []
    for spec in schema:
        key = spec["id"]
        rec = _record(f"core:{key}", "governed", "fleet", _kind(spec.get("type"), spec.get("choices")), spec,
                      visibility="viewer", writable_by="owner", write_via=f"hive-mind config set {key} <value>")
        row = by_id.get(key)
        if row is not None:
            _fill(rec, row.get("value"), row.get("source"))
            rec["set_by"] = row.get("set_by")
        out.append(rec)
    return out


def _template_matches(template, key):
    t, k = template.split("."), key.split(".")
    return len(t) == len(k) and all(a == b or (a.startswith("{") and a.endswith("}")) for a, b in zip(t, k))


def _write_via(module, key, scope, secret):
    base = f"hive-mind module config {module} set {key} "
    tail = {"node": "", "fleet": " --fleet", "fleet-node": " --fleet-node <device>"}[scope]
    return base + ("--stdin" if secret else "<value>") + tail


def _module_records(module, schema, rows):
    by_key = {r.get("key"): r for r in rows}
    out = []
    for key in sorted(schema):
        spec = schema[key]
        scope = spec.get("scope", "node")
        governed = scope != "node"
        secret, ident = bool(spec.get("secret")), bool(spec.get("identifying"))
        kw = dict(secret=secret, identifying=ident, visibility="viewer" if governed else "operator",
                  writable_by="owner" if governed else "operator", write_via=_write_via(module, key, scope, secret))
        cls = "governed" if governed else "module"
        if "{" in key:
            tpl = _record(f"x-{module}:{key}", cls, scope, spec.get("type", "string"), spec, **kw)
            tpl["template"] = True
            out.append(tpl)
            for rk in sorted(r for r in by_key if r not in schema and _template_matches(key, r)):
                inst = _record(f"x-{module}:{rk}", cls, scope, spec.get("type", "string"), spec,
                               **{**kw, "write_via": _write_via(module, rk, scope, secret)})
                inst["instance_of"] = tpl["id"]
                _fill(inst, by_key[rk].get("value"), by_key[rk].get("source"))
                out.append(inst)
            continue
        rec = _record(f"x-{module}:{key}", cls, scope, spec.get("type", "string"), spec, **kw)
        row = by_key.get(key)
        if row is not None:
            _fill(rec, row.get("value"), row.get("source"))
        out.append(rec)
    return out


class Registry:
    """The union of the three sources, as KeyRecords, in a fixed order: node keys, core keys, then modules by name."""

    def __init__(self, prefix=""):
        self.records, self.warnings, self.governance, self.modules = [], [], {}, []
        want_node = not prefix.startswith(("core:", "x-"))
        want_governed = not prefix.startswith(("node:", "x-"))
        want_modules = not prefix.startswith(("node:", "core:"))
        only = prefix[2:prefix.index(":")] if prefix.startswith("x-") and ":" in prefix else None
        if want_node or want_governed:
            schema = core("hv", "config", "schema", "--json")
            if want_node:
                nodes = core("hv", "config", "node", "list", "--json")
                self.records += _node_records(schema.get("node", []), nodes.get("keys", []))
            if want_governed:
                show = core("hv", "config", "show", "--json")
                self.governance = show.get("governance") or {}
                self.records += _governed_records(schema.get("governed", []), show.get("governed", []))
        if want_modules:
            listed = core("hive-mind", "module", "list", "--json").get("modules", [])
            self.modules = sorted(m["name"] for m in listed if MODULE_NAME.match(str(m.get("name", ""))))
            for m in sorted(listed, key=lambda m: str(m.get("name"))):
                name = str(m.get("name", ""))
                if not MODULE_NAME.match(name) or (only and name != only) or not m.get("config_schema"):
                    continue
                try:
                    sch = core("hive-mind", "module", "config", name, "schema", "--json")
                    rows = core("hive-mind", "module", "config", name, "list", "--json")
                except Refused as e:
                    self.warnings.append({"module": name, "message": e.message})
                    continue
                self.records += _module_records(name, sch, rows)

    def select(self, prefix="", cls=None):
        return [r for r in self.records if r["id"].startswith(prefix) and (cls is None or r["class"] == cls)]

    def get(self, id_):
        for r in self.records:
            if r["id"] == id_:
                return r
        if id_.startswith("x-") and ":" in id_ and id_[2:id_.index(":")] not in self.modules:
            raise Refused("not-installed", f"no module {id_[2:id_.index(':')]!r} is installed",
                          "hive-mind module list shows what is installed", id_)
        raise Refused("unknown-key", f"no such key: {id_}", "hconfig schema lists every key", id_)


def schema_view(rec):
    """A record without its value: what `hconfig schema` prints."""
    return {k: v for k, v in rec.items() if k not in ("value", "source", "set", "set_by")}


# ── explain ───────────────────────────────────────────────────────────────────────────────────────

def derive(rec, governance):
    """The consequence lines for one record, from the record and `config show`'s governance block alone."""
    out = []
    if rec["secret"]:
        out.append({"code": "secret", "text": "a secret: its value is never shown and is only ever given on stdin"})
    if rec.get("env") and rec["source"] == "env":
        out.append({"code": "env-override", "text": f"{rec['env']} is set and overrides the node file; a file value "
                                                    "is ignored while it is"})
    if rec["id"] == "core:cap_self" and rec["value"] is not None:
        principals = {a.get("principal") for a in governance.get("admitted", [])}
        if len(principals) == 1:
            out.append({"code": "single-principal", "text": f"single-principal hive: cap_self ({rec['value']}) binds "
                                                            "on every corroborated fact"})
    if rec["id"] == "core:quorum_m" and rec["value"] == 0:
        out.append({"code": "elections-off", "text": "quorum_m = 0: elections are off, so the owner is never replaced "
                                                     "by a vote"})
    if rec["id"] == "core:dead_man_days" and governance.get("quorum_m") == 0:
        out.append({"code": "dead-man-inert", "text": "quorum_m = 0, so dead_man_days has no effect"})
    if rec["id"] in ("node:port", "node:bind") or rec["id"].startswith("node:dashboard_viewer"):
        out.append({"code": "restart", "text": "read when the service starts: restart it after a change"})
    for w in rec["warnings"]:
        out.append({"code": "identifying", "text": w})
    return out


# ── output ────────────────────────────────────────────────────────────────────────────────────────

def _show(v):
    return "-" if v is None else (v if isinstance(v, str) else json.dumps(v))


def _table(rows):
    if not rows:
        return ""
    widths = [max(len(r[i]) for r in rows) for i in range(len(rows[0]) - 1)]
    return "\n".join("  ".join([c.ljust(w) for c, w in zip(r, widths)] + [r[-1]]) for r in rows)


def text_list(recs):
    return _table([[r["id"], _show(r["value"] if r["set"] else r["default"]), f"({r['source'] or 'unset'})"]
                   for r in recs])


def text_schema(recs):
    return _table([[r["id"], f"{r['class']}/{r['scope']}", r["type"] + ("*" if r.get("template") else ""),
                    r["description"]] for r in recs])


def text_record(rec):
    lines = [f"{rec['id']}  [{rec['class']}, scope {rec['scope']}, {rec['type']}]", f"  {rec['description']}"]
    lines.append(f"  value: {_show(rec['value'])}  ({rec['source'] or 'unset'})   default: {_show(rec['default'])}")
    if "values" in rec:
        lines.append("  one of: " + ", ".join(rec["values"]))
    if "min" in rec or "max" in rec:
        lines.append(f"  range: {_show(rec.get('min'))} .. {_show(rec.get('max'))}")
    lines.append(f"  visible to: {rec['visibility']}   written by: {rec['writable_by']}   via: {rec['write_via']}")
    if rec["set_by"]:
        lines.append(f"  set by: {rec['set_by'].get('device_id')} at {rec['set_by'].get('ts')} ({rec['set_by'].get('sid')})")
    lines += [f"  warning: {w}" for w in rec["warnings"]]
    return "\n".join(lines)


def emit(args, payload, text):
    if args.json:
        print(json.dumps({"schema": SCHEMA, "ok": True, **payload}, indent=2))
    elif text:
        print(text)


def refuse(args, e):
    if args.json:
        print(json.dumps({"schema": SCHEMA, "ok": False, "error": {"code": e.code, "id": e.key, "message": e.message,
                                                                    "hint": e.hint}}, indent=2))
    else:
        print(f"hconfig: {e.message}" + (f" ({e.hint})" if e.hint else ""), file=sys.stderr)
    return 1


# ── verbs ─────────────────────────────────────────────────────────────────────────────────────────

def cmd_schema(args):
    reg = Registry(args.prefix)
    recs = [schema_view(r) for r in reg.select(args.prefix)]
    emit(args, {"keys": recs, "warnings": reg.warnings}, text_schema(recs))


def cmd_list(args):
    reg = Registry(args.prefix)
    recs = reg.select(args.prefix, args.cls)
    emit(args, {"keys": recs, "warnings": reg.warnings}, text_list(recs))


def cmd_get(args):
    rec = Registry(args.id).get(args.id)
    emit(args, {"key": rec}, text_record(rec))


def cmd_explain(args):
    reg = Registry(args.id)
    rec = reg.get(args.id)
    derived = derive(rec, reg.governance)
    text = text_record(rec) + ("\n  derived:\n" + "\n".join(f"    - {d['text']}" for d in derived) if derived else "")
    emit(args, {"key": rec, "derived": derived}, text)


def _core_problem():
    """None when the core's config verbs answer, else one line saying why not (no value can be in it)."""
    try:
        core("hv", "config", "schema", "--json")
    except Refused as e:
        return e.message, e.hint
    return None


def cmd_status(args):
    """The contract's status envelope: hconfig has no service, so it is `ok` when the core it reads from answers."""
    bad = _core_problem()
    print(json.dumps({"schema": 1, "state": "degraded" if bad else "ok", "version": VERSION,
                      "problems": [bad[0]] if bad else [], "detail": {}}))


def cmd_doctor(args):
    bad = _core_problem()
    res = {"level": "warn", "check": "core-verbs", "message": bad[0], "fix_hint": bad[1]} if bad else \
        {"level": "ok", "check": "core-verbs", "message": "the core's config verbs answer"}
    print(json.dumps({"schema": 1, "results": [res]}))


def cmd_version(args):
    print(f"hconfig {VERSION}")


def parser():
    ap = argparse.ArgumentParser(prog="hconfig", description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="verb", required=True)
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", action="store_true", help="one JSON object, schema 1")
    p = sub.add_parser("schema", parents=[common], help="every known key, without values")
    p.add_argument("prefix", nargs="?", default="")
    p.set_defaults(fn=cmd_schema)
    p = sub.add_parser("list", parents=[common], help="the records with their merged values")
    p.add_argument("prefix", nargs="?", default="")
    p.add_argument("--class", dest="cls", choices=CLASSES)
    p.set_defaults(fn=cmd_list)
    p = sub.add_parser("get", parents=[common], help="one record")
    p.add_argument("id")
    p.set_defaults(fn=cmd_get)
    p = sub.add_parser("explain", parents=[common], help="one record and what its value means for this hive")
    p.add_argument("id")
    p.set_defaults(fn=cmd_explain)
    for name, fn in (("status", cmd_status), ("doctor", cmd_doctor)):
        p = sub.add_parser(name, parents=[common], help=f"the module contract's {name} answer, JSON")
        p.set_defaults(fn=fn)
    p = sub.add_parser("version")
    p.set_defaults(fn=cmd_version, json=False)
    return ap


def main(argv=None):
    args = parser().parse_args(argv)
    try:
        args.fn(args)
    except Refused as e:
        return refuse(args, e)
    except BrokenPipeError:
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
